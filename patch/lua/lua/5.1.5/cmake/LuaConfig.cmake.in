@PACKAGE_INIT@

# Include targets config
include(${CMAKE_CURRENT_LIST_DIR}/LuaTargets.cmake)

# Set aliases for all possible targets
if(TARGET Lua::liblua)
    add_library(Lua::Library ALIAS Lua::liblua)
endif()
if(TARGET Lua::lua)
    add_executable(Lua::Interpreter ALIAS Lua::lua)
endif()
if(TARGET Lua::luac)
    add_executable(Lua::Compiler ALIAS Lua::luac)
endif()

# Set default components list
if(NOT Lua_FIND_COMPONENTS)
    set(Lua_FIND_COMPONENTS Library)
    foreach(component IN LISTS Lua_FIND_COMPONENTS)
        set(Lua_FIND_REQUIRED_${component} TRUE)
    endforeach()
endif()

# Find components
foreach(component IN ITEMS ${Lua_FIND_COMPONENTS})
    if(NOT TARGET Lua::${component})
        set(Lua_${component}_FOUND FALSE)
        if(Lua_FIND_REQUIRED_${component})
            message(FATAL_ERROR "Could NOT find Lua::${component}")
        endif()
    else()
        set(Lua_${component}_FOUND TRUE)
        message(STATUS "Found Lua::${component}")
    endif()
endforeach()

# Define package as found
set(Lua_FOUND TRUE)
