#include <windows.h>

#include "lua.h"

#ifndef DEBUG
#define VER_DEBUG 0
#else
#define VER_DEBUG VS_FF_DEBUG
#endif

#define VER_PRIVATEBUILD 0x0L
#define VER_PRERELEASE 0x0L

#define LUA_VERSION_STRING "@LUA_RELEASE@"
#define LUA_VERSION_CSV @LUA_VERSION_MAJOR@,@LUA_VERSION_MINOR@,@LUA_VERSION_PATCH@

1 ICON DISCARDABLE "lua.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION LUA_VERSION_CSV
    PRODUCTVERSION LUA_VERSION_CSV
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS (VER_PRIVATEBUILD | VER_PRERELEASE | VER_DEBUG)
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_DLL
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // English (US), Unicode
        BLOCK "040904b0"
        BEGIN
            VALUE "Comment", LUA_AUTHORS
            VALUE "CompanyName", "Lua.org, PUC-Rio\0"
            VALUE "FileDescription", "Lua programming language library\0"
            VALUE "FileVersion", LUA_VERSION_CSV
            VALUE "InternalName", "lua\0"
            VALUE "LegalCopyright", LUA_COPYRIGHT
            VALUE "OriginalFilename", "lua@LUA_VERSION@\0"
            VALUE "ProductName", "Lua"
            VALUE "ProductVersion", LUA_VERSION_STRING
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        // English (US), Unicode
        VALUE "Translation", 0x409, 1200
    END
END
