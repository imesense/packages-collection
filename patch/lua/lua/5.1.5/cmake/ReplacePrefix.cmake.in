# Replace import prefix
file(READ
    ${CMAKE_INSTALL_PREFIX}/lib/cmake/lua-@LUA_VERSION@/LuaTargets.cmake
    LUA_TARGETS_CONTENT
)
string(REGEX REPLACE
    "set\\(_IMPORT_PREFIX \"[^\"]*\"\\)"
    "set(_IMPORT_PREFIX \"\${CMAKE_CURRENT_LIST_DIR}/../../..\")"
    LUA_TARGETS_CONTENT
    ${LUA_TARGETS_CONTENT}
)
file(WRITE
    ${CMAKE_INSTALL_PREFIX}/lib/cmake/lua-@LUA_VERSION@/LuaTargets.cmake
    ${LUA_TARGETS_CONTENT}
)
