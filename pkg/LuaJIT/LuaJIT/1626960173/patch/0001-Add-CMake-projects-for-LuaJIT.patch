diff --git a/cmake/DetectArchitecture.cmake b/cmake/DetectArchitecture.cmake
new file mode 100644
index 00000000..d3e1951d
--- /dev/null
+++ b/cmake/DetectArchitecture.cmake
@@ -0,0 +1,47 @@
+if(NOT LUAJIT_TARGET_ARCH STREQUAL "")
+    return()
+endif()
+
+if(WIN32)
+    if(CMAKE_VS_PLATFORM_NAME MATCHES "^(x86|Win32)$")
+        set(LUAJIT_TARGET_ARCH "x86")
+    elseif(CMAKE_VS_PLATFORM_NAME MATCHES "^x64$")
+        set(LUAJIT_TARGET_ARCH "x64")
+    elseif(CMAKE_VS_PLATFORM_NAME MATCHES "^ARM$")
+        set(LUAJIT_TARGET_ARCH "arm32")
+    elseif(CMAKE_VS_PLATFORM_NAME MATCHES "^ARM64$")
+        set(LUAJIT_TARGET_ARCH "arm64")
+    else()
+        if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86)$")
+            set(LUAJIT_TARGET_ARCH "x86")
+        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|x64)$")
+            set(LUAJIT_TARGET_ARCH "x64")
+        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(armv7|arm)$")
+            set(LUAJIT_TARGET_ARCH "arm32")
+        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
+            set(LUAJIT_TARGET_ARCH "arm64")
+        endif()
+    endif()
+elseif(LINUX)
+    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86)$")
+        set(LUAJIT_TARGET_ARCH "x86")
+    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64)$")
+        set(LUAJIT_TARGET_ARCH "x64")
+    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(armv[6-9]|arm|armhf)$")
+        set(LUAJIT_TARGET_ARCH "arm32")
+    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
+        set(LUAJIT_TARGET_ARCH "arm64")
+    endif()
+elseif(APPLE)
+    if(CMAKE_OSX_ARCHITECTURES MATCHES "^x86_64$")
+        set(LUAJIT_TARGET_ARCH "x64")
+    elseif(CMAKE_OSX_ARCHITECTURES MATCHES "^arm64$")
+        set(LUAJIT_TARGET_ARCH "arm64")
+    else()
+        if(CMAKE_SYSTEM_PROCESSOR MATCHES "^x86_64$")
+            set(LUAJIT_TARGET_ARCH "x64")
+        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
+            set(LUAJIT_TARGET_ARCH "arm64")
+        endif()
+    endif()
+endif()
diff --git a/cmake/EmbedManifest.cmake b/cmake/EmbedManifest.cmake
new file mode 100644
index 00000000..d6660769
--- /dev/null
+++ b/cmake/EmbedManifest.cmake
@@ -0,0 +1,29 @@
+function(generate_manifest source destination)
+    if(NOT WIN32 AND NOT MSVC)
+        return()
+    endif()
+
+    configure_file(
+        ${source}
+        ${destination}
+    )
+endfunction()
+
+function(embed_manifest target_name target_type manifest_file)
+    if(NOT WIN32 AND NOT MSVC)
+        return()
+    endif()
+
+    if(target_type STREQUAL "EXE")
+        set(id_value 1)
+    elseif(target_type STREQUAL "DLL")
+        set(id_value 2)
+    else()
+        message(FATAL_ERROR "Invalid target type: ${target_type}. Expected 'EXE' or 'DLL'!")
+    endif()
+
+    set_target_properties(${target_name}
+        PROPERTIES
+            LINK_FLAGS "/MANIFEST:EMBED,ID=${id_value} /MANIFESTINPUT:${manifest_file}"
+    )
+endfunction()
