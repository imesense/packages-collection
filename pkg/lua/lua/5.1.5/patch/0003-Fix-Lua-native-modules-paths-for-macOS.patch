From f74fdb7b6a4c1f0b49fcd19251bc3a65b6b5d94f Mon Sep 17 00:00:00 2001
From: acidicMercury8 <acidicmercury8@outlook.com>
Date: Wed, 19 Feb 2025 18:59:21 +0300
Subject: [PATCH 3/3] Fix Lua native modules paths for macOS

---
 src/luaconf.h | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/luaconf.h b/src/luaconf.h
index 51993c0..f14c44a 100644
--- a/src/luaconf.h
+++ b/src/luaconf.h
@@ -92,7 +92,15 @@
 		             LUA_CDIR"?.lua;"  LUA_CDIR"?\\init.lua"
 #define LUA_CPATH_DEFAULT \
 	".\\?.dll;"  LUA_CDIR"?.dll;" LUA_CDIR"loadall.dll"
-
+#elif defined(LUA_USE_MACOSX)
+#define LUA_ROOT	"/usr/local/"
+#define LUA_LDIR	LUA_ROOT "share/lua/5.1/"
+#define LUA_CDIR	LUA_ROOT "lib/lua/5.1/"
+#define LUA_PATH_DEFAULT  \
+		"./?.lua;"  LUA_LDIR"?.lua;"  LUA_LDIR"?/init.lua;" \
+		            LUA_CDIR"?.lua;"  LUA_CDIR"?/init.lua"
+#define LUA_CPATH_DEFAULT \
+	"./?.dylib;"  LUA_CDIR"?.dylib;" LUA_CDIR"loadall.dylib"
 #else
 #define LUA_ROOT	"/usr/local/"
 #define LUA_LDIR	LUA_ROOT "share/lua/5.1/"
