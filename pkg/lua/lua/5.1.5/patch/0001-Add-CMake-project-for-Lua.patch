+    set_target_properties(Readline::Library::History
+        PROPERTIES
+            IMPORTED_LOCATION ${Readline_History_LIBRARY}
+            INTERFACE_INCLUDE_DIRECTORIES ${Readline_History_INCLUDE}
+    )
