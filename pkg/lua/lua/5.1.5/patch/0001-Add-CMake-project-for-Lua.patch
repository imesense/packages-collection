diff --git a/cmake/liblua.rc.in b/cmake/liblua.rc.in
new file mode 100644
index 0000000..dcae2d3
--- /dev/null
+++ b/cmake/liblua.rc.in
@@ -0,0 +1,50 @@
+#include <windows.h>
+
+#include "lua.h"
+
+#ifndef DEBUG
+#define VER_DEBUG 0
+#else
+#define VER_DEBUG VS_FF_DEBUG
+#endif
+
+#define VER_PRIVATEBUILD 0x0L
+#define VER_PRERELEASE 0x0L
+
+#define LUA_VERSION_STRING "@LUA_RELEASE@"
+#define LUA_VERSION_CSV @LUA_VERSION_MAJOR@,@LUA_VERSION_MINOR@,@LUA_VERSION_PATCH@
+
+1 ICON DISCARDABLE "lua.ico"
+
+VS_VERSION_INFO VERSIONINFO
+    FILEVERSION LUA_VERSION_CSV
+    PRODUCTVERSION LUA_VERSION_CSV
+    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
+    FILEFLAGS (VER_PRIVATEBUILD | VER_PRERELEASE | VER_DEBUG)
+    FILEOS VOS_NT_WINDOWS32
+    FILETYPE VFT_DLL
+    FILESUBTYPE VFT2_UNKNOWN
+BEGIN
+    BLOCK "StringFileInfo"
+    BEGIN
+        // English (US), Unicode
+        BLOCK "040904b0"
+        BEGIN
+            VALUE "Comment", LUA_AUTHORS
+            VALUE "CompanyName", "Lua.org, PUC-Rio\0"
+            VALUE "FileDescription", "Lua programming language library\0"
