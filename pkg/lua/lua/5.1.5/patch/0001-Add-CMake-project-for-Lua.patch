+    COMMAND $<TARGET_FILE:lua> ${CMAKE_CURRENT_SOURCE_DIR}/fib.lua
+)
+add_test(
+    NAME fibfor
+    COMMAND $<TARGET_FILE:lua> ${CMAKE_CURRENT_SOURCE_DIR}/fibfor.lua
+)
+add_test(
