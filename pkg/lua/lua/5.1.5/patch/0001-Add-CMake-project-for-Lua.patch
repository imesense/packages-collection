+    ${CMAKE_CURRENT_SOURCE_DIR}/loslib.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/lstrlib.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/ltablib.c
+)
