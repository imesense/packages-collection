+    NAMES
+        readline/readline.h
+    PATHS
+        /usr/include
+        /usr/local/include
+)
+find_library(Readline_History_LIBRARY
+    NAMES
+        history
+    PATHS
+        /usr/lib
+        /usr/local/lib
+)
