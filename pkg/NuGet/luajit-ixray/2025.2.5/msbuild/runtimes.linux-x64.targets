<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <LuaJIT-RootPath>$(MSBuildThisFileDirectory)\..\..</LuaJIT-RootPath>
        <LuaJIT-BinPath>$(LuaJIT-RootPath)\runtimes\linux-x64\native\</LuaJIT-BinPath>
    </PropertyGroup>

    <ItemGroup>
        <ReferenceCopyLocalPaths Include="$(LuaJIT-BinPath)\libluajit.so.2.0" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="cd $(OutDir)" />
        <Exec Command="ln -s libluajit.so.2.0 libluajit.so.2" />
        <Exec Command="ln -s libluajit.so.2 libluajit.so" />
    </Target>
</Project>
